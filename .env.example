# --- Global Configuration ---
APP_ENV=development
DEBUG=True
PORT=8000

# --- Database (MongoDB) ---
MONGO_URI=mongodb://localhost:27017/fraud_detection
MONGO_DB_NAME=fraud_detection_db

# --- AI & RAG (Groq + LangChain) ---
GROQ_API_KEY=your_groq_api_key_here
CHROMA_DB_PATH=./rag/knowledge_base/chroma_db

# --- Security & Encryption ---
# Generate a strong 32-byte key for AES-256 (e.g., openssl rand -hex 32)
ENCRYPTION_KEY=your_secret_32_byte_hex_key_here
JWT_SECRET=your_jwt_secret_here

# --- ML Model ---
MODEL_PATH=./models/fraud_model.joblib
FRAUD_THRESHOLD=0.7
